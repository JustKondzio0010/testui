        self._openButton = create("Frame", {
            Parent = root,
            BackgroundColor3 = theme.Panel2,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(0, 220, 0, 40),
        })
        create("UICorner", {Parent = self._openButton, CornerRadius = UDim.new(0, 16)})
        create("UIStroke", {
            Parent = self._openButton,
            Color = theme.Stroke,
            Thickness = opts.StrokeThickness or 2,
            Transparency = 0.4,
        })

        local btn = create("TextButton", {
            Parent = self._openButton,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Text = "",
            Font = Enum.Font.Gotham,
        })
        create("UIListLayout", {
            Parent = btn,
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Center,
        })

        local icon = create("ImageLabel", {
            Parent = btn,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 20, 0, 20),
            Image = "",
            ImageColor3 = theme.Text,
        })
        local label = create("TextLabel", {
            Parent = btn,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -24, 1, 0),
            Font = Enum.Font.GothamBold,
            Text = "",
            TextColor3 = theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        btn.MouseButton1Click:Connect(function()
            self._holder.Visible = true
            self._openButton.Visible = false
        end)

        if opts.Draggable ~= false then
            MakeDraggable(btn, self._openButton)
        end

        self._openButtonBtn   = btn
        self._openButtonIcon  = icon
        self._openButtonLabel = label
    end

    self._openButtonLabel.Text = opts.Title or "Open EzHub"

    if opts.Icon then
        local id
        if opts.Icon:match("^rbxassetid://") then
            id = opts.Icon
        else
            id = self._ezhub._iconProvider(opts.Icon)
        end
        self._openButtonIcon.Image = id or ""
    end

    self._openButton.Visible = opts.Enabled ~= false and (not self._holder.Visible)
end

