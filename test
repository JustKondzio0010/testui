--// ScreenGui singleton
local function getScreenGui()
    local playerGui = LOCAL_PLAYER:WaitForChild("PlayerGui")
    local gui = playerGui:FindFirstChild("EzHubUI")
    if not gui then
        gui = create("ScreenGui", {
            Name = "EzHubUI",
            ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Global,
            IgnoreGuiInset = true,
        })
        gui.Parent = playerGui
    end
    return gui
end

--// Tween helper
local function tween(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

--// Make draggable
local function makeDraggable(dragArea, dragObject)
    local dragging
    local dragStart
    local startPos

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = dragObject.Position
        end
    end)

    dragArea.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or
                         input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            dragObject.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--// EzHub constructor
function EzHub.new()
    local self = setmetatable({}, EzHub)
    self._theme = deepCopy(Themes.Dark)
    self._windows = {}
    return self
end

-- global singleton (jak EzHub = loadstring(...)())
local singleton = EzHub.new()

--// Theme API
function EzHub:SetTheme(themeNameOrTable)
    if type(themeNameOrTable) == "string" then
        local base = Themes[themeNameOrTable]
        if not base then
            warn("[EzHub] Unknown theme:", themeNameOrTable)
            return
        end
        self._theme = deepCopy(base)
    elseif type(themeNameOrTable) == "table" then
        self._theme = deepCopy(themeNameOrTable)
    end

    -- możesz tu dodać re-theming okien jeśli chcesz
end

function EzHub:GetTheme()
    return self._theme
end

