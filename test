        Parent = listHolder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    })

    local buttons = {}
    local opened = false

    local function fire(v)
        selected = v
        valueLabel.Text = tostring(v)
        if type(callback) == "function" then
            task.spawn(callback, v)
        end
    end

    local function rebuild()
        for _, b in ipairs(buttons) do b:Destroy() end
        table.clear(buttons)
        for _, v in ipairs(values) do
            local btn = create("TextButton", {
                Parent = listHolder,
                BackgroundColor3 = theme.Panel,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 24),
                AutoButtonColor = false,
                Font = Enum.Font.Gotham,
                Text = tostring(v),
                TextColor3 = theme.TextMuted,
                TextSize = 13,
            })
            btn.MouseEnter:Connect(function()
                tween(btn, TweenInfo.new(0.1), {BackgroundColor3 = theme.Panel2})
            end)
            btn.MouseLeave:Connect(function()
                tween(btn, TweenInfo.new(0.1), {BackgroundColor3 = theme.Panel})
            end)
            btn.MouseButton1Click:Connect(function()
                fire(v)
                opened = false
                listHolder.Visible = false
                arrow.Text = "▼"
            end)
            table.insert(buttons, btn)
        end
    end

    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            opened = not opened
            listHolder.Visible = opened
            arrow.Text = opened and "▲" or "▼"
        end
    end)

    rebuild()
    if selected ~= nil then fire(selected) end

    return {
        Set = function(_, v) fire(v) end,
        Get = function() return selected end,
        Refresh = function(_, newValues)
            values = newValues or {}
            rebuild()
        end,
    }
end

return singleton
