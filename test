--// Window:CreateTab
function Window:CreateTab(name, iconName)
    local theme = self._theme
    local iconProvider = self._ezhub._iconProvider

    local btn = create("TextButton", {
        Parent = self._tabList,
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 36),
        AutoButtonColor = false,
        Text = "",
    })

    create("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 10)})

    create("UIStroke", {
        Parent = btn,
        Color = theme.Stroke,
        Transparency = 0.6,
    })

    local icon = create("ImageLabel", {
        Parent = btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0.5, -10),
        Size = UDim2.new(0, 20, 0, 20),
        Image = iconName and iconProvider(iconName) or "",
        ImageColor3 = theme.TextMuted,
    })

    local label = create("TextLabel", {
        Parent = btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 38, 0, 0),
        Size = UDim2.new(1, -48, 1, 0),
        Font = Enum.Font.Gotham,
        Text = name,
        TextColor3 = theme.TextMuted,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local indicator = create("Frame", {
        Parent = btn,
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, -3, 0.5, 0),
        Size = UDim2.new(0, 3, 1, -10),
        Visible = false,
    })

    local page = create("ScrollingFrame", {
        Parent = self._contentHolder,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = theme.Stroke,
        Visible = false,
        CanvasSize = UDim2.new(0, 0, 0, 0),
    })

    local layout = create("UIListLayout", {
        Parent = page,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 10),
    })

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    local tabObj = setmetatable({
        _window = self,
        _theme = theme,
        _button = btn,
        _page = page,
        _label = label,
        _icon = icon,
        _indicator = indicator,
        _sections = {},
        _name = name,
    }, Tab)

    table.insert(self._tabs, tabObj)

    local function activate()
        if self._activeTab == tabObj then return end
        for _, t in ipairs(self._tabs) do
            t._page.Visible = false
            t._indicator.Visible = false
            tween(t._button, TweenInfo.new(0.18), {BackgroundTransparency = 0.7})
            tween(t._label, TweenInfo.new(0.18), {TextColor3 = theme.TextMuted})
            tween(t._icon, TweenInfo.new(0.18), {ImageColor3 = theme.TextMuted})
        end
        self._activeTab = tabObj
        tabObj._page.Visible = true
        tabObj._indicator.Visible = true
        tween(btn, TweenInfo.new(0.18), {BackgroundTransparency = 0.1})
        tween(label, TweenInfo.new(0.18), {TextColor3 = theme.Text})
        tween(icon, TweenInfo.new(0.18), {ImageColor3 = theme.Accent})
    end

    btn.MouseButton1Click:Connect(activate)
    if #self._tabs == 1 then
        activate()
    end

    return tabObj
end

