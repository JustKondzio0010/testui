function Window:EditOpenButton(opts)
    opts = opts or {}
    local theme = self._theme
    local root = getOpenButtonRoot()

    if self._openButton and not opts.Enabled then
        self._openButton:Destroy()
        self._openButton = nil
        return
    end

    if opts.OnlyMobile and not UserInputService.TouchEnabled then
        if self._openButton then
            self._openButton.Visible = false
        end
        return
    end

    if not self._openButton then
        self._openButton = create("Frame", {
            Parent = root,
            BackgroundColor3 = theme.Panel2,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(0, 220, 0, 40),
        })
        create("UICorner", {Parent = self._openButton, CornerRadius = opts.CornerRadius or UDim.new(0, 16)})
        create("UIStroke", {
            Parent = self._openButton,
            Color = theme.Stroke,
            Thickness = opts.StrokeThickness or 1.5,
            Transparency = 0.4,
        })
        local gradColor = opts.Color or ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.Accent),
            ColorSequenceKeypoint.new(1, theme.Accent2),
        })
        create("UIGradient", {
            Parent = self._openButton,
            Color = gradColor,
            Rotation = 0,
            Transparency = NumberSequence.new{
                NumberSequenceKeypoint.new(0, 0.7),
                NumberSequenceKeypoint.new(1, 0.7),
            },
        })

        local btn = create("TextButton", {
            Parent = self._openButton,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Font = Enum.Font.Gotham,
            Text = "",
        })

        local layout = create("UIListLayout", {
            Parent = btn,
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Center,
        })

        local iconImg = create("ImageLabel", {
            Parent = btn,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 20, 0, 20),
            Image = "",
            ImageColor3 = theme.Text,
        })

        local label = create("TextLabel", {
            Parent = btn,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -24, 1, 0),
            Font = Enum.Font.GothamBold,
            Text = "",
            TextColor3 = theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        self._openButtonBtn = btn
        self._openButtonIcon = iconImg
        self._openButtonLabel = label

        btn.MouseButton1Click:Connect(function()
            self._main.Visible = true
            self._openButton.Visible = false
        end)

        if opts.Draggable ~= false then
            makeDraggable(btn, self._openButton)
        end
    end

    local title = opts.Title or "Open UI"
    self._openButtonLabel.Text = title

    if opts.Icon then
        local id
        if opts.Icon:match("^rbxassetid://") then
            id = opts.Icon
        else
            id = self._ezhub._iconProvider(opts.Icon)
        end
        self._openButtonIcon.Image = id or ""
    end

    self._openButton.Visible = opts.Enabled ~= false and not self._main.Visible
