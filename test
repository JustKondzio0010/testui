function Tab:_getDefaultSection()
    if not self._defaultSection then
        self._defaultSection = self:CreateSection(self._name)
    end
    return self._defaultSection
end

function Tab:CreateButton(opts)   return self:_getDefaultSection():CreateButton(opts)   end
