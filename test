--// THEME & ICON API
function EzHub:SetTheme(nameOrTable)
    if type(nameOrTable) == "string" then
        local base = Themes[nameOrTable]
        if base then
            self._themeName = nameOrTable
            self._theme = cloneTheme(base)
        else
            warn("[EzHub] Unknown theme:", nameOrTable)
        end
    elseif type(nameOrTable) == "table" then
        self._themeName = "Custom"
        self._theme = cloneTheme(nameOrTable)
    end
end

function EzHub:GetTheme()
    return self._theme
end

function EzHub:RegisterTheme(name, def)
    Themes[name] = def
end

function EzHub:SetIconProvider(fn)
    if type(fn) == "function" then
        self._iconProvider = fn
    end
end

--// NOTIFICATIONS (WindUI-like API)
-- EzHub:Notify({ Title, Content, Duration, Icon, IconThemed? })
function EzHub:Notify(opts)
    opts = opts or {}
    local theme = self._theme
    local root = getNotificationRoot()

    local title = opts.Title or "Notification"
    local content = opts.Content or opts.Description or ""
    local duration = tonumber(opts.Duration) or 5
    local iconId = ""
    if typeof(opts.Icon) == "string" then
        if opts.Icon:match("^rbxassetid://") then
            iconId = opts.Icon
        else
            iconId = self._iconProvider(opts.Icon) or ""
        end
    end

    local frame = create("Frame", {
        Parent = root,
        BackgroundColor3 = theme.Panel2,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
    })
    create("UICorner", {Parent = frame, CornerRadius = UDim.new(0, 10)})
    create("UIStroke", {
        Parent = frame,
        Color = theme.Stroke,
        Transparency = 0.4,
    })
    create("UIPadding", {
        Parent = frame,
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    })

    local layout = create("UIListLayout", {
        Parent = frame,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        VerticalAlignment = Enum.VerticalAlignment.Center,
    })

    if iconId ~= "" then
        create("ImageLabel", {
            Parent = frame,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 20, 0, 20),
            Image = iconId,
            ImageColor3 = opts.IconThemed and theme.Accent or Color3.new(1,1,1),
        })
    end

    local textHolder = create("Frame", {
        Parent = frame,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -24, 0, 0),
    })
    create("UIListLayout", {
        Parent = textHolder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    })

    create("TextLabel", {
        Parent = textHolder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    create("TextLabel", {
        Parent = textHolder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Font = Enum.Font.Gotham,
        Text = content,
        TextColor3 = theme.TextMuted,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- enter animation
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0, 30, 0, 0)
    tween(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0,
        Position = UDim2.new(0, 0, 0, 0),
    })

    task.spawn(function()
        task.wait(duration)
        tween(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 30, 0, 0),
        })
        task.wait(0.22)
        if frame and frame.Parent then
            frame:Destroy()
        end
    end)
end

