function EzHub:Notify(opts)
    opts = opts or {}
    local theme = self._theme
    local root = getNotificationRoot()

    local title = opts.Title or "Notification"
    local desc = opts.Description or ""
    local duration = tonumber(opts.Duration) or 4
    local ntype = (opts.Type or "Info"):lower()

    local stripeColor = theme.Accent
    if ntype == "success" then
        stripeColor = theme.Success
    elseif ntype == "error" or ntype == "danger" then
        stripeColor = theme.Danger
    end

    local iconId = ""
    if typeof(opts.Icon) == "string" then
        if opts.Icon:match("^rbxassetid://") then
            iconId = opts.Icon
        else
            iconId = self._iconProvider(opts.Icon) or ""
        end
    end

    local base = create("Frame", {
        Parent = root,
        BackgroundColor3 = theme.Panel2,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 0.05,
    })

    create("UICorner", {Parent = base, CornerRadius = UDim.new(0, 14)})
    create("UIStroke", {
        Parent = base,
        Color = theme.Stroke,
        Transparency = 0.4,
    })

    create("UIGradient", {
        Parent = base,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.Panel2),
            ColorSequenceKeypoint.new(1, theme.Panel),
        }),
        Rotation = 90,
    })

    local stripe = create("Frame", {
        Parent = base,
        BackgroundColor3 = stripeColor,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 4, 1, 0),
    })
    create("UICorner", {Parent = stripe, CornerRadius = UDim.new(0, 14)})

    create("UIPadding", {
        Parent = base,
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
    })

    local layout = create("UIListLayout", {
        Parent = base,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8),
        VerticalAlignment = Enum.VerticalAlignment.Center,
    })

    if iconId ~= "" then
        create("ImageLabel", {
            Parent = base,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 24, 0, 24),
            Image = iconId,
            ImageColor3 = stripeColor,
        })
    end

    local textHolder = create("Frame", {
        Parent = base,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -40, 0, 0),
    })

    create("UIListLayout", {
        Parent = textHolder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
    })

    create("TextLabel", {
        Parent = textHolder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = theme.Text,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    create("TextLabel", {
        Parent = textHolder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Font = Enum.Font.Gotham,
        Text = desc,
        TextColor3 = theme.TextMuted,
        TextSize = 13,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- wejście
    base.BackgroundTransparency = 1
    base.Position = UDim2.new(0, 40, 0, 0)
    stripe.Size = UDim2.new(0, 0, 1, 0)

    tween(base, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.05,
        Position = UDim2.new(0, 0, 0, 0),
    })
    tween(stripe, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 4, 1, 0),
    })

    task.spawn(function()
        task.wait(duration)
        tween(base, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 40, 0, 0),
        })
        task.wait(0.22)
        if base and base.Parent then
            base:Destroy()
        end
    end)
end

