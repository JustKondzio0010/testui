function Section:CreateToggle(opts)
    opts = opts or {}
    local theme = self._theme
    local default = opts.Default or false

    local holder = create("Frame", {
        Parent = self._content,
        BackgroundColor3 = theme.Background2,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 32),
    })

    create("UICorner", {
        Parent = holder,
        CornerRadius = UDim.new(0, 8),
    })

    create("UIStroke", {
        Parent = holder,
        Color = theme.Stroke,
        Transparency = 0.6,
    })

    local title = create("TextLabel", {
        Parent = holder,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -80, 1, 0),
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Toggle",
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local subtitle = create("TextLabel", {
        Parent = holder,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, -2),
        Size = UDim2.new(1, -80, 1, 0),
        Font = Enum.Font.Gotham,
        Text = opts.Description or "",
        TextColor3 = theme.TextMuted,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local toggleButton = create("TextButton", {
        Parent = holder,
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0, 40, 0, 20),
        AutoButtonColor = false,
        Text = "",
    })

    create("UICorner", {
        Parent = toggleButton,
        CornerRadius = UDim.new(1, 0),
    })

    local knob = create("Frame", {
        Parent = toggleButton,
        BackgroundColor3 = theme.Text,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.new(0, 16, 0, 16),
    })

    create("UICorner", {
        Parent = knob,
        CornerRadius = UDim.new(1, 0),
    })

    local state = default

    local function applyState(animated)
        local targetPos = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        local targetColor = state and theme.Success or theme.Background

        if animated then
            tween(toggleButton, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = targetColor,
            })
            tween(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = targetPos,
            })
        else
            toggleButton.BackgroundColor3 = targetColor
            knob.Position = targetPos
        end

        if type(opts.Callback) == "function" then
            task.spawn(opts.Callback, state)
        end
    end

    toggleButton.MouseButton1Click:Connect(function()
        state = not state
        applyState(true)
    end)

    applyState(false)

    return {
        Set = function(_, v)
            state = v and true or false
            applyState(true)
        end,
        Get = function()
            return state
        end,
    }
end

function Section:CreateSlider(opts)
    opts = opts or {}
    local theme = self._theme

    local min = opts.Min or 0
    local max = opts.Max or 100
    local default = opts.Default or min
    local rounding = opts.Rounding or 0

    local holder = create("Frame", {
        Parent = self._content,
        BackgroundColor3 = theme.Background2,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 44),
    })

    create("UICorner", {
        Parent = holder,
        CornerRadius = UDim.new(0, 8),
    })

    create("UIStroke", {
        Parent = holder,
        Color = theme.Stroke,
        Transparency = 0.6,
    })

    local title = create("TextLabel", {
        Parent = holder,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -80, 0, 20),
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Slider",
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local valueLabel = create("TextLabel", {
        Parent = holder,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 0),
        Size = UDim2.new(0, 60, 0, 20),
        Font = Enum.Font.Gotham,
        Text = tostring(default),
        TextColor3 = theme.TextMuted,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local sliderBar = create("Frame", {
        Parent = holder,
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 10, 0, 24),
        Size = UDim2.new(1, -20, 0, 10),
    })

    create("UICorner", {
        Parent = sliderBar,
        CornerRadius = UDim.new(0, 999),
    })

    local fill = create("Frame", {
        Parent = sliderBar,
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
    })

    create("UICorner", {
        Parent = fill,
        CornerRadius = UDim.new(0, 999),
    })

    local knob = create("Frame", {
        Parent = sliderBar,
        BackgroundColor3 = theme.Text,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14),
    })

    create("UICorner", {
        Parent = knob,
        CornerRadius = UDim.new(1, 0),
    })

    local dragging = false
    local currentValue = default

    local function snapValue(x)
        if rounding > 0 then
            local pow = 10 ^ rounding
            return math.floor(x * pow + 0.5) / pow
        end
        return math.floor(x)
    end

    local function setValue(v, fromInput)
        v = math.clamp(v, min, max)
        v = snapValue(v)
        currentValue = v

        local alpha = (v - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(v)

        if fromInput and type(opts.Callback) == "function" then
            task.spawn(opts.Callback, v)
        end
    end

    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local rel = (input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X
            setValue(min + (max - min) * rel, true)
        end
    end)

    sliderBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = (input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X
            setValue(min + (max - min) * rel, true)
        end
    end)

    setValue(default, false)

    return {
        Set = function(_, v) setValue(v, true) end,
        Get = function() return currentValue end,
    }
end

function Section:CreateDropdown(opts)
    opts = opts or {}
    local theme = self._theme

    local values = opts.Values or {}
    local default = opts.Default or values[1]
    local callback = opts.Callback

    local holder = create("Frame", {
        Parent = self._content,
        BackgroundColor3 = theme.Background2,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 32),
        ClipsDescendants = true,
    })

    create("UICorner", {
        Parent = holder,
        CornerRadius = UDim.new(0, 8),
    })

    create("UIStroke", {
        Parent = holder,
        Color = theme.Stroke,
        Transparency = 0.6,
    })

    local title = create("TextLabel", {
        Parent = holder,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -80, 1, 0),
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Dropdown",
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local currentLabel = create("TextLabel", {
        Parent = holder,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -28, 0.5, 0),
        Size = UDim2.new(0, 120, 0, 18),
        Font = Enum.Font.Gotham,
        Text = tostring(default or "-"),
        TextColor3 = theme.TextMuted,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        ClipsDescendants = true,
    })

    local arrow = create("TextLabel", {
        Parent = holder,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14),
        Font = Enum.Font.GothamBold,
        Text = "▼",
        TextColor3 = theme.TextMuted,
        TextSize = 14,
    })

    local listHolder = create("Frame", {
        Parent = holder,
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 0),
    })

    create("UIStroke", {
        Parent = listHolder,
        Color = theme.Stroke,
        Transparency = 0.7,
    })

    local listLayout = create("UIListLayout", {
        Parent = listHolder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    })

    local opened = false
    local selected = default

    local function updateListSize()
        local height = listLayout.AbsoluteContentSize.Y + 6
        listHolder.Size = UDim2.new(1, 0, 0, height)
        holder.Size = UDim2.new(1, 0, 0, opened and (32 + height) or 32)
    end

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateListSize)

    local buttons = {}

    local function selectValue(v)
        selected = v
        currentLabel.Text = tostring(v)
        if type(callback) == "function" then
            task.spawn(callback, v)
        end
    end

    for _, v in ipairs(values) do
        local btn = create("TextButton", {
            Parent = listHolder,
            BackgroundColor3 = theme.Background,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 24),
            AutoButtonColor = false,
            Font = Enum.Font.Gotham,
            Text = tostring(v),
            TextColor3 = theme.TextMuted,
            TextSize = 13,
        })

        btn.MouseEnter:Connect(function()
            tween(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = theme.Background2,
            })
        end)

        btn.MouseLeave:Connect(function()
            tween(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = theme.Background,
            })
        end)

        btn.MouseButton1Click:Connect(function()
            selectValue(v)
            opened = false
            updateListSize()
            arrow.Text = "▼"
        end)

        table.insert(buttons, btn)
    end

    holder.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            opened = not opened
            arrow.Text = opened and "▲" or "▼"
            updateListSize()
        end
    end)

    updateListSize()
    if default ~= nil then
        selectValue(default)
    end

    return {
        Set = function(_, v) selectValue(v) end,
        Get = function() return selected end,
        Refresh = function(_, newValues)
            for _, b in ipairs(buttons) do
                b:Destroy()
            end
            table.clear(buttons)
            values = newValues or {}
            for _, v in ipairs(values) do
                local btn = create("TextButton", {
                    Parent = listHolder,
                    BackgroundColor3 = theme.Background,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 24),
                    AutoButtonColor = false,
                    Font = Enum.Font.Gotham,
                    Text = tostring(v),
                    TextColor3 = theme.TextMuted,
                    TextSize = 13,
                })

                btn.MouseEnter:Connect(function()
                    tween(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundColor3 = theme.Background2,
                    })
                end)

                btn.MouseLeave:Connect(function()
                    tween(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundColor3 = theme.Background,
                    })
                end)

                btn.MouseButton1Click:Connect(function()
                    selectValue(v)
                    opened = false
                    updateListSize()
                    arrow.Text = "▼"
                end)

                table.insert(buttons, btn)
            end
            updateListSize()
        end,
    }
end

