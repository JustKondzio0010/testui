--// WINDOW METHODS

function Window:_ensureToggleConnection()
    if self._toggleConn then
        self._toggleConn:Disconnect()
        self._toggleConn = nil
    end
    if not self._toggleKey then return end

    self._toggleConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == self._toggleKey then
            self._main.Visible = not self._main.Visible
            if self._openButton then
                self._openButton.Visible = not self._main.Visible
            end
        end
    end)
end

function Window:SetToggleKey(keyCode)
    self._toggleKey = keyCode
    self:_ensureToggleConnection()
end

