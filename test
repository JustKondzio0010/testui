    })
    create("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 8)})
    create("UIStroke", {
        Parent = btn,
        Color = theme.Stroke,
        Transparency = 0.6,
    })

    local iconId = iconName and iconProvider(iconName) or ""
    local icon = create("ImageLabel", {
        Parent = btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 8, 0.5, -9),
        Size = UDim2.new(0, 18, 0, 18),
        Image = iconId,
        ImageColor3 = theme.TextMuted,
    })
    local label = create("TextLabel", {
        Parent = btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 30, 0, 0),
        Size = UDim2.new(1, -34, 1, 0),
        Font = Enum.Font.Gotham,
        Text = name,
        TextColor3 = theme.TextMuted,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local page = create("ScrollingFrame", {
        Parent = self._pagesHolder,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, -70), -- zostawiamy miejsce na profil
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = theme.Stroke,
        Visible = false,
        CanvasSize = UDim2.new(0, 0, 0, 0),
    })
    local layout = create("UIListLayout", {
        Parent = page,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 10),
    })
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    local tabObj = setmetatable({
        _window = self,
        _theme = theme,
        _button = btn,
        _label = label,
        _icon = icon,
        _page = page,
        _sections = {},
        _name = name,
        _defaultSection = nil,
    }, Tab)

    table.insert(self._tabs, tabObj)

    local function activate()
        if self._activeTab == tabObj then return end
        for _, t in ipairs(self._tabs) do
            t._page.Visible = false
            tween(t._button, TweenInfo.new(0.15), {BackgroundTransparency = 0.7})
            tween(t._label, TweenInfo.new(0.15), {TextColor3 = theme.TextMuted})
            tween(t._icon, TweenInfo.new(0.15), {ImageColor3 = theme.TextMuted})
        end
        self._activeTab = tabObj
        tabObj._page.Visible = true
        tween(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.1})
        tween(label, TweenInfo.new(0.15), {TextColor3 = theme.Text})
        tween(icon, TweenInfo.new(0.15), {ImageColor3 = theme.Accent})
    end

    btn.MouseButton1Click:Connect(activate)
    if #self._tabs == 1 then
        activate()
    end

    return tabObj
end

