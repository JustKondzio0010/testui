--// Create player profile panel (bottom-left)
local function createProfilePanel(parent, theme)
    local panelHeight = 70

    local profileFrame = create("Frame", {
        Parent = parent,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 8, 1, -8),
        Size = UDim2.new(1, -16, 0, panelHeight),
        BackgroundColor3 = theme.Panel,
        BorderSizePixel = 0,
    })

    create("UICorner", {
        Parent = profileFrame,
        CornerRadius = UDim.new(0, 10),
    })

    create("UIStroke", {
        Parent = profileFrame,
        Color = theme.Stroke,
        Transparency = 0.6,
    })

    local avatar = create("ImageLabel", {
        Parent = profileFrame,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 48, 0, 48),
        Position = UDim2.new(0, 10, 0.5, -24),
        Image = "",
        ImageColor3 = Color3.new(1, 1, 1),
    })

    create("UICorner", {
        Parent = avatar,
        CornerRadius = UDim.new(1, 0),
    })

    local nameLabel = create("TextLabel", {
        Parent = profileFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 68, 0, 12),
        Size = UDim2.new(1, -76, 0, 18),
        Font = Enum.Font.GothamBold,
        Text = LOCAL_PLAYER.Name,
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local subLabel = create("TextLabel", {
        Parent = profileFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 68, 0, 30),
        Size = UDim2.new(1, -76, 0, 16),
        Font = Enum.Font.Gotham,
        Text = "Player ID: " .. LOCAL_PLAYER.UserId,
        TextColor3 = theme.TextMuted,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- thumbnail
    task.spawn(function()
        local success, content = pcall(function()
            local thumb, _ = Players:GetUserThumbnailAsync(
                LOCAL_PLAYER.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
            return thumb
        end)
        if success and content then
            avatar.Image = content
        end
    end)

    return profileFrame, panelHeight
end

