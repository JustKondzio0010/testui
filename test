-- THEME / ICON API
function EzHub:SetTheme(name)
    if Themes[name] then
        self._themeName = name
        self._theme = cloneTheme(Themes[name])
    else
        warn("[EzHub] unknown theme:", name)
    end
end

function EzHub:GetTheme()
    return self._theme
end

function EzHub:SetIconProvider(fn)
    if type(fn) == "function" then
        self._iconProvider = fn
    end
end

-- NOTIFY (małe, po prawej)
function EzHub:Notify(opts)
    opts = opts or {}
    local theme = self._theme
    local root = getNotificationRoot()

    local title   = opts.Title   or "Notification"
    local content = opts.Content or opts.Description or ""
    local dur     = tonumber(opts.Duration) or 5

    local iconId = ""
    if typeof(opts.Icon) == "string" then
        if opts.Icon:match("^rbxassetid://") then
            iconId = opts.Icon
        else
            iconId = self._iconProvider(opts.Icon) or ""
        end
    end

    local frame = create("Frame", {
        Parent = root,
        BackgroundColor3 = theme.Panel2,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
    })
    create("UICorner", {Parent = frame, CornerRadius = UDim.new(0, 10)})
    create("UIStroke", {Parent = frame, Color = theme.Stroke, Transparency = 0.4})
    create("UIPadding", {
        Parent = frame,
        PaddingTop = UDim.new(0, 6),
        PaddingBottom = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
    })

    local layout = create("UIListLayout", {
        Parent = frame,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        VerticalAlignment = Enum.VerticalAlignment.Center,
    })

    if iconId ~= "" then
        create("ImageLabel", {
            Parent = frame,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 18, 0, 18),
            Image = iconId,
            ImageColor3 = theme.Accent,
        })
    end

    local textHolder = create("Frame", {
        Parent = frame,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -24, 0, 0),
    })
    create("UIListLayout", {
        Parent = textHolder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    })

    create("TextLabel", {
        Parent = textHolder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    create("TextLabel", {
        Parent = textHolder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Font = Enum.Font.Gotham,
        Text = content,
        TextColor3 = theme.TextMuted,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0, 24, 0, 0)
    TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0,
        Position = UDim2.new(0, 0, 0, 0),
    }):Play()

    task.spawn(function()
        task.wait(dur)
        TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 24, 0, 0),
        }):Play()
        task.wait(0.22)
        if frame and frame.Parent then
            frame:Destroy()
        end
    end)
end

