--// ScreenGui + notifications
local function getScreenGui()
    local pg = LOCAL_PLAYER:WaitForChild("PlayerGui")
    local gui = pg:FindFirstChild("EzHubUI")
    if not gui then
        gui = create("ScreenGui", {
            Name = "EzHubUI",
            ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Global,
            IgnoreGuiInset = true,
        })
        gui.Parent = pg
    end
    return gui
end

local function getNotificationRoot()
    local gui = getScreenGui()
    local root = gui:FindFirstChild("EzHubNotifications")
    if not root then
        root = create("Frame", {
            Name = "EzHubNotifications",
            Parent = gui,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -20, 0.5, 0),
            Size = UDim2.new(0, 320, 1, -40),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
        })

        create("UIListLayout", {
            Parent = root,
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Center,
        })
    end
    return root
end

