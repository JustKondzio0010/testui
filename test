        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end)

    local tabObj = setmetatable({
        _window = self,
        _theme  = theme,
        _button = btn,
        _label  = label,
        _icon   = icon,
        _page   = page,
        _name   = name,
        _sections = {},
        _defaultSection = nil,
    }, Tab)

    table.insert(self._tabs, tabObj)

    local function activate()
        if self._activeTab == tabObj then return end
        for _, t in ipairs(self._tabs) do
            t._page.Visible = false
            TweenService:Create(t._button, TweenInfo.new(0.15), {BackgroundTransparency = 0.75}):Play()
            TweenService:Create(t._label,  TweenInfo.new(0.15), {TextColor3 = theme.TextMuted}):Play()
            TweenService:Create(t._icon,   TweenInfo.new(0.15), {ImageColor3 = theme.TextMuted}):Play()
        end
        self._activeTab = tabObj
        tabObj._page.Visible = true
        TweenService:Create(btn,   TweenInfo.new(0.18), {BackgroundTransparency = 0.1}):Play()
        TweenService:Create(label, TweenInfo.new(0.18), {TextColor3 = theme.Text}):Play()
        TweenService:Create(icon,  TweenInfo.new(0.18), {ImageColor3 = theme.Accent}):Play()
    end

    btn.MouseButton1Click:Connect(function()
        local pos = UserInputService:GetMouseLocation()
        CircleClick(btn, pos.X, pos.Y)
        activate()
    end)

    if #self._tabs == 1 then
        activate()
    end

    return tabObj
end

