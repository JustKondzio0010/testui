    create("UIPadding", {
        Parent = holder,
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    })
    create("UIListLayout", {
        Parent = holder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
    })

    local header = create("Frame", {
        Parent = holder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
    })
    create("UIListLayout", {
        Parent = header,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    })

    create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -50, 0, 0),
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Slider",
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local valueLabel = create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 50, 0, 16),
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = theme.TextMuted,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local bar = create("Frame", {
        Parent = holder,
        BackgroundColor3 = theme.Panel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 8),
    })
    create("UICorner", {Parent = bar, CornerRadius = UDim.new(0, 999)})
    local fill = create("Frame", {
        Parent = bar,
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
    })
    create("UICorner", {Parent = fill, CornerRadius = UDim.new(0, 999)})
    local knob = create("Frame", {
        Parent = bar,
        BackgroundColor3 = theme.Text,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, 0, 0.5, 0),
    })
    create("UICorner", {Parent = knob, CornerRadius = UDim.new(1, 0)})

    local dragging = false
    local function snap(x)
        if rounding > 0 then
            local pow = 10 ^ rounding
            return math.floor(x * pow + 0.5) / pow
        end
        return math.floor(x)
    end

    local function apply(v, fire)
        v = math.clamp(v, min, max)
        v = snap(v)
        value = v
        local alpha = (v - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(v)
        if fire and type(opts.Callback) == "function" then
            task.spawn(opts.Callback, v)
        end
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
            apply(min + (max - min) * rel, true)
        end
    end)
    bar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
            apply(min + (max - min) * rel, true)
        end
    end)

    apply(value, false)

    return {
        Set = function(_, v) apply(v, true) end,
        Get = function() return value end,
    }
end

