        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.new(0, 18, 0, 18),
    })

    create("UICorner", {Parent = knob, CornerRadius = UDim.new(1, 0)})

    local state = default

    local function apply(animated)
        local alpha = state and 1 or 0
        local pos = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        local bg = state and theme.Success or theme.Panel

        if animated then
            tween(toggleBtn, TweenInfo.new(0.16), {BackgroundColor3 = bg})
            tween(knob, TweenInfo.new(0.16), {Position = pos})
        else
            toggleBtn.BackgroundColor3 = bg
            knob.Position = pos
        end

        if type(opts.Callback) == "function" then
            task.spawn(opts.Callback, state)
        end
    end

    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        apply(true)
    end)

    apply(false)

    return {
        Set = function(_, v) state = v and true or false; apply(true) end,
        Get = function() return state end,
    }
end

function Section:CreateSlider(opts)
    opts = opts or {}
    local theme = self._theme

    local min = opts.Min or 0
    local max = opts.Max or 100
    local value = opts.Default or min
    local rounding = opts.Rounding or 0

    local holder = create("Frame", {
        Parent = self._frame,
        BackgroundColor3 = theme.Panel2,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
    })

    create("UICorner", {Parent = holder, CornerRadius = UDim.new(0, 10)})
    create("UIStroke", {Parent = holder, Color = theme.Stroke, Transparency = 0.6})

    create("UIPadding", {
        Parent = holder,
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    })

    local layout = create("UIListLayout", {
        Parent = holder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
    })

    local header = create("Frame", {
        Parent = holder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
    })

    local headerLayout = create("UIListLayout", {
        Parent = header,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    })

    local nameLabel = create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -50, 0, 0),
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Slider",
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local valueLabel = create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 50, 0, 16),
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = theme.TextMuted,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local bar = create("Frame", {
        Parent = holder,
        BackgroundColor3 = theme.Panel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 8),
    })

    create("UICorner", {Parent = bar, CornerRadius = UDim.new(0, 999)})

    local fill = create("Frame", {
        Parent = bar,
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
    })

    create("UICorner", {Parent = fill, CornerRadius = UDim.new(0, 999)})

    local knob = create("Frame", {
        Parent = bar,
        BackgroundColor3 = theme.Text,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, 0, 0.5, 0),
    })

    create("UICorner", {Parent = knob, CornerRadius = UDim.new(1, 0)})

    local dragging = false

    local function snap(v)
        if rounding > 0 then
            local pow = 10 ^ rounding
            return math.floor(v * pow + 0.5) / pow
        end
        return math.floor(v)
    end

    local function apply(v, fireCallback)
        v = math.clamp(v, min, max)
        v = snap(v)
        value = v
        local alpha = (v - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(v)
        if fireCallback and type(opts.Callback) == "function" then
            task.spawn(opts.Callback, v)
        end
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
            apply(min + (max - min) * rel, true)
        end
    end)

    bar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
            apply(min + (max - min) * rel, true)
        end
    end)

    apply(value, false)

    return {
        Set = function(_, v) apply(v, true) end,
        Get = function() return value end,
    }
end

function Section:CreateDropdown(opts)
    opts = opts or {}
    local theme = self._theme

    local values = opts.Values or {}
    local selected = opts.Default or values[1]
    local callback = opts.Callback

    local holder = create("Frame", {
        Parent = self._frame,
        BackgroundColor3 = theme.Panel2,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        ClipsDescendants = true,
    })

    create("UICorner", {Parent = holder, CornerRadius = UDim.new(0, 10)})
    create("UIStroke", {Parent = holder, Color = theme.Stroke, Transparency = 0.6})

    create("UIPadding", {
        Parent = holder,
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    })

    local layout = create("UIListLayout", {
        Parent = holder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
    })

    local header = create("Frame", {
        Parent = holder,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
    })

    local headerLayout = create("UIListLayout", {
        Parent = header,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    })

    local nameLabel = create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -80, 0, 0),
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Dropdown",
        TextColor3 = theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local valueLabel = create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 80, 0, 18),
        Font = Enum.Font.Gotham,
        Text = tostring(selected or "-"),
        TextColor3 = theme.TextMuted,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local arrow = create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 16, 0, 16),
        Font = Enum.Font.GothamBold,
        Text = "▼",
        TextColor3 = theme.TextMuted,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Center,
    })

    local listHolder = create("Frame", {
        Parent = holder,
        BackgroundColor3 = theme.Panel,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Visible = false,
    })

    create("UICorner", {Parent = listHolder, CornerRadius = UDim.new(0, 8)})

    local listLayout = create("UIListLayout", {
        Parent = listHolder,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    })

    local buttons = {}
    local opened = false

    local function fire(v)
        selected = v
        valueLabel.Text = tostring(v)
        if type(callback) == "function" then
            task.spawn(callback, v)
        end
    end

    local function buildList()
        for _, b in ipairs(buttons) do b:Destroy() end
        table.clear(buttons)

        for _, v in ipairs(values) do
            local btn = create("TextButton", {
                Parent = listHolder,
                BackgroundColor3 = theme.Panel,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 24),
                AutoButtonColor = false,
                Font = Enum.Font.Gotham,
                Text = tostring(v),
                TextColor3 = theme.TextMuted,
                TextSize = 13,
            })

            btn.MouseEnter:Connect(function()
                tween(btn, TweenInfo.new(0.1), {BackgroundColor3 = theme.Panel2})
            end)

            btn.MouseLeave:Connect(function()
                tween(btn, TweenInfo.new(0.1), {BackgroundColor3 = theme.Panel})
            end)

            btn.MouseButton1Click:Connect(function()
                fire(v)
                opened = false
                listHolder.Visible = false
                arrow.Text = "▼"
            end)

            table.insert(buttons, btn)
        end
    end

    buildList()
    if selected then fire(selected) end

    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            opened = not opened
            listHolder.Visible = opened
            arrow.Text = opened and "▲" or "▼"
        end
    end)

    return {
        Set = function(_, v) fire(v) end,
        Get = function() return selected end,
        Refresh = function(_, newValues)
            values = newValues or {}
            buildList()
        end,
    }
end

return singleton
