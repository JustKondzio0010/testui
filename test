function Window:CreateTab(name, iconName)
    local theme = self._theme

    local tabButton = create("TextButton", {
        Parent = self._tabList,
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.7,
        Size = UDim2.new(1, -16, 0, 34),
        Position = UDim2.new(0, 8, 0, 0),
        AutoButtonColor = false,
        Font = Enum.Font.Gotham,
        Text = "",
        TextSize = 14,
    })

    create("UICorner", {
        Parent = tabButton,
        CornerRadius = UDim.new(0, 8),
    })

    local tabStroke = create("UIStroke", {
        Parent = tabButton,
        Color = theme.Stroke,
        Transparency = 0.6,
    })

    local iconId = iconName and IconMap[iconName] or nil

    local iconLabel = create("ImageLabel", {
        Parent = tabButton,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 10, 0.5, -9),
        Image = iconId or "",
        ImageColor3 = theme.TextMuted,
    })

    local textLabel = create("TextLabel", {
        Parent = tabButton,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -44, 1, 0),
        Position = UDim2.new(0, 34, 0, 0),
        Font = Enum.Font.Gotham,
        Text = name,
        TextColor3 = theme.TextMuted,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local indicator = create("Frame", {
        Parent = tabButton,
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 2, 1, -10),
        Position = UDim2.new(0, -2, 0, 5),
        Visible = false,
    })

    local page = create("ScrollingFrame", {
        Parent = self._contentHolder,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        ScrollBarImageColor3 = theme.Stroke,
        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Name = name .. "_Page",
    })

    local pageLayout = create("UIListLayout", {
        Parent = page,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8),
    })

    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 8)
    end)

    local tabObj = setmetatable({
        _window = self,
        _theme = theme,
        _name = name,
        _button = tabButton,
        _icon = iconLabel,
        _textLabel = textLabel,
        _indicator = indicator,
        _page = page,
        _sections = {},
    }, Tab)

    table.insert(self._tabs, tabObj)

    local function setActive()
        if self._activeTab == tabObj then return end

        for _, t in ipairs(self._tabs) do
            t._page.Visible = false
            t._indicator.Visible = false
            tween(t._button, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.7,
            })
            tween(t._textLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                TextColor3 = self._theme.TextMuted,
            })
            tween(t._icon, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                ImageColor3 = self._theme.TextMuted,
            })
        end

        self._activeTab = tabObj
        tabObj._page.Visible = true
        tabObj._indicator.Visible = true

        tween(tabButton, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0.2,
        })
        tween(textLabel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            TextColor3 = theme.Text,
        })
        tween(iconLabel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            ImageColor3 = theme.Accent,
        })
    end

    tabButton.MouseButton1Click:Connect(setActive)

    if #self._tabs == 1 then
        setActive()
    end

    return tabObj
end

