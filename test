--// Tween helper
local function tween(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

--// Draggable
local function makeDraggable(handle, dragObject)
    local dragging = false
    local dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = dragObject.Position
        end
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            dragObject.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--// ScreenGui singleton
local function getScreenGui()
    local pg = LOCAL_PLAYER:WaitForChild("PlayerGui")
    local gui = pg:FindFirstChild("EzHubUI")
    if not gui then
        gui = create("ScreenGui", {
            Name = "EzHubUI",
            ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Global,
            IgnoreGuiInset = true,
        })
        gui.Parent = pg
    end
    return gui
end

--// Theme API
function EzHub:SetTheme(nameOrTable)
    if type(nameOrTable) == "string" then
        local base = Themes[nameOrTable]
        if base then
            self._themeName = nameOrTable
            self._theme = cloneTheme(base)
        else
            warn("[EzHub] Unknown theme: ", nameOrTable)
        end
    elseif type(nameOrTable) == "table" then
        self._themeName = "Custom"
        self._theme = cloneTheme(nameOrTable)
    end
end

function EzHub:RegisterTheme(name, def)
    Themes[name] = def
end

function EzHub:SetIconProvider(fn)
    if type(fn) == "function" then
        self._iconProvider = fn
    end
end

function EzHub:GetTheme()
    return self._theme
end

